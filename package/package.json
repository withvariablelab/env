{
  "name": "@variablelab/env",
  "version": "0.5.5",
  "description": "Only declared variables, checked at boot.",
  "homepage": "https://github.com/withvariablelab/env/tree/main/package#readme",
  "bugs": {
    "url": "https://github.com/withvariablelab/env/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/withvariablelab/env.git",
    "directory": "package"
  },
  "license": "MIT",
  "author": "rcrd <ricardo@variable.land>",
  "type": "module",
  "keywords": [
    "env",
    "environment",
    "config",
    "configuration",
    "typed",
    "standard-schema",
    "zod",
    "vite"
  ],
  "exports": {
    ".": "./src/lib/index.ts",
    "./fs": "./src/fs.ts",
    "./vite": "./src/vite.ts",
    "./react": "./src/react.tsx",
    "./zod": "./src/zod.ts"
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "!src/**/*.test.*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:browser": "vitest --browser.headless=false",
    "prepublishOnly": "rr pack"
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0",
    "defu": "6.1.7"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./fs": {
        "types": "./dist/fs.d.mts",
        "default": "./dist/fs.mjs"
      },
      "./vite": {
        "types": "./dist/vite.d.mts",
        "default": "./dist/vite.mjs"
      },
      "./react": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "./zod": {
        "types": "./dist/zod.d.ts",
        "default": "./dist/zod.js"
      }
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@rrlab/ts-config": "catalog:",
    "@rrlab/tsdown-config": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "4.1.12",
    "playwright": "1.59.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:",
    "vitest-browser-react": "2.1.0",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "vite": ">=5",
    "zod": "^4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
