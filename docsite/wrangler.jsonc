{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vlandoss-env-docs",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  // Paths must match Vite's `base` in vite.config.ts.
  "routes": [
    // Only /env is ours on lab.variable.land. Whatever serves the rest of the host must leave these
    // paths alone: a zone Redirect Rule runs before Workers, so it has to exclude them explicitly.
    { "pattern": "lab.variable.land/env", "zone_name": "variable.land" },
    { "pattern": "lab.variable.land/env/*", "zone_name": "variable.land" },
    // Legacy host, kept attached so src/server.ts can 301 old links to lab.variable.land/env.
    { "pattern": "env.oss.variable.land", "custom_domain": true }
  ],
  // Workers Builds runs `wrangler preview` on non-production branches; it requires this block.
  "previews": {}
}
